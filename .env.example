DATABASE_HOST=localhost
POSTGRES_DB=rento
POSTGRES_USER=rento
POSTGRES_PASSWORD=yourpassword

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# SMTP (Mailpit for local dev)
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=rento@localhost
# SMTP_USE_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# SMTP (Gmail) — used by Agent 3 to send outreach emails to apartment hosts.
# SMTP_HOST: Gmail's outbound mail server. Always smtp.gmail.com for Gmail.
# SMTP_PORT: 587 = STARTTLS (recommended). Use 465 for SSL-only (rare).
# SMTP_USE_TLS: Must be true for Gmail. Encrypts the connection via STARTTLS.
# SMTP_USERNAME: Your full Gmail address — Gmail uses this to authenticate.
#                Must be the complete address, e.g. you@gmail.com (not just "you").
# SMTP_PASSWORD: A Gmail App Password, NOT your regular Gmail login password.
#                Generate one at: Google Account → Security → 2-Step Verification → App passwords.
#                Format: 16 chars with spaces, e.g. "xxxx xxxx xxxx xxxx".
# SMTP_FROM: The "From" address shown to recipients. Should match SMTP_USERNAME
#            so Gmail accepts the send (mismatched From = likely rejected or spam).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=your-gmail@gmail.com

# Agent configuration
AGENT2_TOP_N_MATCHES=20
AGENT3_MAX_NEGOTIATION_ROUNDS=5
AGENT3_REPLY_POLL_INTERVAL_SECONDS=1800

# CORS — comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT — change this to a long random secret in any real deployment
JWT_SECRET=put-your-JWT-secret-here
JWT_EXPIRE_HOURS=168

# Debug mode — enables dev-only endpoints (e.g. /agents/dev/*).
DEBUG=true

# Gmail inbound reply polling
# If SMTP_FROM is not a Gmail address (e.g. you send via Cornell Office 365),
# set REPLY_TO_BASE to a Gmail account you control. Host replies will be
# addressed to <gmail_local>+<match_id>@gmail.com and polled by the Gmail API.
# Leave blank to derive Reply-To from SMTP_FROM (only works if SMTP_FROM is Gmail).
REPLY_TO_BASE=

# Gmail inbound reply polling
# Required to receive real host replies via Gmail subaddress routing.
# 1. Create a Google Cloud project and enable the Gmail API.
# 2. Download OAuth credentials (Desktop app type) → save as credentials.json.
# 3. On first server start, a browser window opens for one-time authorisation.
#    After that, token.json is reused automatically.
# 4. Set SMTP_FROM to the same Gmail account (e.g. youragent@gmail.com).
#    SMTP must also point to Gmail: HOST=smtp.gmail.com PORT=587 USE_TLS=true
#    and SMTP_PASSWORD must be a Gmail App Password (not your account password).
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# How often (seconds) to poll Gmail for new host replies. 60s is fine for demos.
GMAIL_REPLY_POLL_INTERVAL_SECONDS=60
